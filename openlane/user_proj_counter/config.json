{
    "//": "user_proj_counter: hardened on its own (LibreLane 3) as a dense macro,",
    "//2": "then placed as a MACROS entry inside double_wide_openframe_project_wrapper's",
    "//3": "config.json -- matching how openframe_project_wrapper/user_project_wrapper",
    "//4": "integrate user_proj_timer/user_proj_example. The wrapper itself is",
    "//5": "elaborate-only (no std cells of its own besides this macro), so this is",
    "//6": "the only place tap/endcap/fill/CTS run for this design's real logic.",

    "DESIGN_NAME": "user_proj_counter",
    "VERILOG_FILES": [
        "dir::../../verilog/rtl/user_proj_counter.v"
    ],
    "VERILOG_DEFINES": ["PnR"],

    "CLOCK_PORT": "clk",
    "CLOCK_PERIOD": 25,
    "PNR_SDC_FILE": "dir::user_proj_counter.sdc",
    "SIGNOFF_SDC_FILE": "dir::user_proj_counter.sdc",

    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 200, 4000],
    "IO_PIN_ORDER_CFG": "dir::pin_order.cfg",

    "FP_CORE_UTIL": 45,
    "PL_TARGET_DENSITY_PCT": 55,
    "PL_RESIZER_SETUP_SLACK_MARGIN": 0.4,
    "GRT_RESIZER_SETUP_SLACK_MARGIN": 0.2,
    "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.2,
    "PL_RESIZER_HOLD_SLACK_MARGIN": 0.4,
    "RUN_POST_GRT_DESIGN_REPAIR": true,
    "DESIGN_REPAIR_MAX_SLEW_PCT": 30,
    "DESIGN_REPAIR_MAX_CAP_PCT": 30,
    "GRT_DESIGN_REPAIR_MAX_SLEW_PCT": 30,
    "GRT_DESIGN_REPAIR_MAX_CAP_PCT": 30,
    "DESIGN_REPAIR_MAX_WIRE_LENGTH": 800,
    "GRT_DESIGN_REPAIR_MAX_WIRE_LENGTH": 800,

    "MAGIC_DEF_LABELS": false,
    "SYNTH_ABC_BUFFERING": false,
    "RUN_HEURISTIC_DIODE_INSERTION": false,
    "GRT_REPAIR_ANTENNAS": true,
    "GRT_ANTENNA_ITERS": 10,
    "DIODE_ON_PORTS": "in",

    "VDD_NETS": ["vccd1"],
    "GND_NETS": ["vssd1"],
    "RT_MAX_LAYER": "met4",

    "MAX_TRANSITION_CONSTRAINT": 1.0,
    "MAX_FANOUT_CONSTRAINT": 16
}
